{
  "name": "multilocale",
  "version": "1.3.3",
  "private": false,
  "description": "Multilocale CLI — software localization projects, phrases, translation files and machine translation from the terminal. npx multilocale",
  "license": "Apache-2.0",
  "repository": "github:multilocale/cli",
  "homepage": "https://www.multilocale.com/developers/",
  "author": "Multilocale",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "bin": {
    "multilocale": "./bin/multilocale.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "develop": "node index.js",
    "prepublishOnly": "npm run build",
    "publish:npm": "npm publish --access public",
    "publish:repo": "node scripts/publishCli.mjs",
    "test": "vitest run",
    "test:smoke": "node scripts/build.js && node --check dist/index.js && node dist/index.js --version"
  },
  "files": [
    "bin",
    "dist",
    "skills"
  ],
  "keywords": [
    "multi-language",
    "multilingual",
    "translate",
    "localize",
    "internationalize",
    "translation",
    "i18n",
    "cli"
  ],
  "dependencies": {
    "commander": "8.3.0",
    "fs-extra": "10.1.0",
    "inquirer": "8.2.5",
    "node-localstorage": "2.2.1",
    "xml2js": "0.4.23"
  },
  "devDependencies": {
    "@monorepool/agentfirst": "0.0.0",
    "@monorepool/root": "0.0.0",
    "@monorepool/shared": "0.0.0",
    "@multilocale/client": "0.0.0",
    "esbuild": "0.25.4",
    "openai": "5.8.3"
  }
}
